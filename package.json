{
  "name": "pinterest-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for the Pinterest API v5 — boards, pins, analytics, search and OAuth, over stdio or HTTP.",
  "license": "MIT",
  "author": "aymandakirgh",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pinterest-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsc --watch",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pinterest",
    "pinterest-api",
    "claude",
    "llm",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aymandakirgh/pinterest-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/aymandakirgh/pinterest-mcp/issues"
  },
  "homepage": "https://github.com/aymandakirgh/pinterest-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
